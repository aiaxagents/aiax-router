<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Notarization requires the hardened runtime, and the hardened runtime refuses
  the executable memory V8 allocates. Without these two the bundled Node server
  is killed with SIGTRAP the moment the app starts it, and the window waits
  forever for a board URL that never comes.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
